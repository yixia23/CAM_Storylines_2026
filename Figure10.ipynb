    "def lat_formatter(x, pos):\n",
    "    hemi = 'N' if x > 0 else 'S' if x < 0 else ''\n",
    "    return f\"{abs(int(x))}°{hemi}\"\n",
    "\n",
    "def lon_formatter(x, pos):\n",
    "    if x < 180:\n",
    "        return f\"{int(x)}°E\"\n",
    "    elif x == 180:\n",
    "        return f\"{int(x)}°\"\n",
    "    else:\n",
    "        return f\"{int(360-x)}°W\""
   ]
